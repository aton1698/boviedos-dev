# CV download form. Copy to .env.local for local work; set the same names in Vercel for production.
# Without these, development and previews use Cloudflare's always-pass test keys and only log the requests.

# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (free tier): emails each CV request to you. https://resend.com
RESEND_API_KEY=
# Sender: use a verified domain in production; "onboarding@resend.dev" only reaches your own Resend account email.
RESEND_FROM=
# Where the requests arrive (defaults to the email in content/profile.ts).
CV_NOTIFY_TO=
